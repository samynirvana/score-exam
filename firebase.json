{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".vscode/**",
      ".agent/**",
      ".firebase/**",
      "**/.git/**",
      "**/.vscode/**",
      "**/node_modules/**",
      "firestore.rules",
      "linkconverter.py"
    ]
  },
  "firestore": [
    {
      "database": "mrsyamdb",
      "rules": "firestore.rules"
    }
  ]
}
