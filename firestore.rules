rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Staff / Admin authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaffOrAdmin() {
      return isAuthenticated();
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Analytics can be read only by admins. Student sessions are custom sessions,
    // so their event writes are limited to known student codes and fixed fields.
    match /user_activity_events/{eventId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['userKey', 'role', 'type', 'at'])
        && request.resource.data.keys().hasAll(['userKey', 'role', 'type', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.type == 'login'
        && ((request.resource.data.role == 'staff'
          && isAuthenticated()
          && request.resource.data.userKey == 'staff:' + request.auth.uid)
          || (request.resource.data.role == 'student'
          && request.resource.data.userKey.matches('student:[A-Za-z0-9_-]{1,32}')
          && exists(/databases/$(database)/documents/students/$(request.resource.data.userKey.split(':')[1]))));
      allow update, delete: if false;
    }

    match /user_activity/{activityId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['userKey', 'role', 'lastLogin', 'lastAction', 'lastActionAt', 'lastExit', 'lastPage', 'lastVisit'])
        && request.resource.data.keys().hasAll(['userKey', 'role', 'lastLogin'])
        && request.resource.data.lastLogin == request.time
        && ((request.resource.data.role == 'staff'
          && isAuthenticated()
          && activityId == 'staff_' + request.auth.uid
          && request.resource.data.userKey == 'staff:' + request.auth.uid)
          || (request.resource.data.role == 'student'
          && request.resource.data.userKey.matches('student:[A-Za-z0-9_-]{1,32}')
          && activityId == 'student_' + request.resource.data.userKey.split(':')[1]
          && exists(/databases/$(database)/documents/students/$(request.resource.data.userKey.split(':')[1]))));
      allow delete: if false;
    }

    // 1. Students & Student Profiles
    // Students can read and update (e.g., photoUrl); Staff/Admin can create/delete
    match /students/{studentId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if isStaffOrAdmin();
    }

    // 2. Exam Scores & Grades
    match /exam_scores/{scoreId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 3. Behavior / Merit & Demerit Points
    match /student_points/{pointId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 4. School News & Updates
    match /news_updates/{newsId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 5. Quizzes, System Quizzes & Results
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /system_quizzes/{quizId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /quiz_results/{resultId} {
      allow read, create, delete: if true;
      allow update: if isStaffOrAdmin();
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 5b. Live Quizzes & Live Participants (Real-time monitoring, anti-cheat & synced state)
    match /live_quizzes/{quizId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();

      match /participants/{studentCode} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isStaffOrAdmin();
      }
    }

    // 6. Users (Admin & Teacher Accounts)
    match /users/{userId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 7. Timeline Posts & Comments (Posts, Likes, Polls, Self-Deletion)
    match /timeline_posts/{postId} {
      allow read, create, update, delete: if true;
    }

    match /timeline_comments/{commentId} {
      allow read, create, update, delete: if true;
    }

    // 8. Direct Messages & Notifications
    match /direct_messages/{msgId} {
      allow read, create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    match /timeline_notifications/{notifId} {
      allow read, create, update: if true;
      allow delete: if isStaffOrAdmin();
    }

    // 9. Configurations & Schedules (Academic Calendar, Classes, Master Schedule)
    match /config/{configId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 10. Attendance Sessions & Student Attendance Records
    match /attendance_sessions/{sessionId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /attendance_records/{recordId} {
      allow read, create, update: if true;
      allow delete: if isStaffOrAdmin();
    }

    // 11. Interactive Boards & Brainstorming Studio
    match /boards/{boardId} {
      allow read, create, update, delete: if true;
    }

    // 12. Wi-Fi File & Message Transfer Signaling
    match /wifiRooms/{roomId}/{document=**} {
      allow read, write: if true;
    }

    // 13. Simple Notes for Teachers & Students (Cloud Sync)
    match /user_notes/{noteId} {
      allow read, create, update, delete: if true;
    }

    // 14. Gamified Learning Module Config & Question Customization
    match /learning_modules_config/{configId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /learning_custom_questions/{questionId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }


    // Default fallback for any other subcollections
    match /{topCollection}/{document=**} {
      allow read: if topCollection != 'user_activity_events' && topCollection != 'user_activity';
      allow write: if topCollection != 'user_activity_events' && topCollection != 'user_activity' && isStaffOrAdmin();
    }
  }
}
